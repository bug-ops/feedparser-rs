<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:slash="http://purl.org/rss/1.0/modules/slash/"
     xmlns:wfw="http://wellformedweb.org/CommentAPI/">
  <channel>
    <title>Test Blog</title>
    <link>https://example.com</link>
    <description>A test blog feed with slash and wfw namespaces</description>
    <item>
      <title>My Post</title>
      <link>https://example.com/my-post</link>
      <slash:comments>42</slash:comments>
      <wfw:commentRss>https://example.com/my-post/comments/feed/</wfw:commentRss>
    </item>
    <item>
      <title>Post With Zero Comments</title>
      <link>https://example.com/zero-comments</link>
      <slash:comments>0</slash:comments>
      <wfw:commentRss>https://example.com/zero-comments/comments/feed/</wfw:commentRss>
    </item>
    <item>
      <title>Post Without Comment Fields</title>
      <link>https://example.com/no-comments</link>
    </item>
  </channel>
</rss>
